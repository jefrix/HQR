<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Holographic Projection Visualizations</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <style>
        body { 
            margin: 0; 
            background-color: black; 
            display: grid; 
            grid-template-columns: repeat(2, 1fr); 
            grid-template-rows: repeat(2, auto); 
            gap: 10px; 
            justify-items: center;
            align-items: center;
            padding: 20px;
        }
        .canvas-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }
        canvas { 
            display: block; 
            width: 400px; 
            height: 400px; 
        }
        .label { 
            color: white; 
            text-align: center; 
            font-size: 18px; 
            margin-top: 10px;
        }
    </style>
</head>
<body>
    <!-- Containers for Each Visualization -->
    <div class="canvas-container">
        <canvas id="canvas1"></canvas>
        <div class="label">Base Holographic Projection</div>
    </div>
    <div class="canvas-container">
        <canvas id="canvas2"></canvas>
        <div class="label">Observer Effects</div>
    </div>
    <div class="canvas-container">
        <canvas id="canvas3"></canvas>
        <div class="label">Entropy Evolution with Observer Effects</div>
    </div>
    <div class="canvas-container">
        <canvas id="canvas4"></canvas>
        <div class="label">Full Model: Entropy + Observer Effects</div>
    </div>

    <script>
        function createScene(canvasId, observerEffect = false, entropy = false) {
            const canvas = document.getElementById(canvasId);
            const scene = new THREE.Scene();
            const camera = new THREE.PerspectiveCamera(75, canvas.clientWidth / canvas.clientHeight, 0.1, 1000);
            const renderer = new THREE.WebGLRenderer({ canvas });
            renderer.setSize(canvas.clientWidth, canvas.clientHeight);
            
            const group = new THREE.Group();
            scene.add(group);

            const geometry = new THREE.BufferGeometry();
            const points = [];
            const numPoints = 1000;

            for (let i = 0; i < numPoints; i++) {
                let theta = Math.random() * Math.PI * 2;
                let phi = Math.acos(2 * Math.random() - 1);
                let r = Math.pow(Math.random(), 1/3);
                let x = r * Math.sin(phi) * Math.cos(theta);
                let y = r * Math.sin(phi) * Math.sin(theta);
                let z = r * Math.cos(phi);
                points.push(x, y, z);
            }

            geometry.setAttribute('position', new THREE.Float32BufferAttribute(points, 3));
            const material = new THREE.PointsMaterial({ color: 0x00ccff, size: 0.02 });
            const particles = new THREE.Points(geometry, material);
            group.add(particles);

            camera.position.z = 3;

            function animate() {
                requestAnimationFrame(animate);
                
                // Observer effect: Modify rotation dynamically
                if (observerEffect) {
                    group.rotation.x += 0.005 * Math.sin(Date.now() * 0.001);
                    group.rotation.y += 0.005 * Math.cos(Date.now() * 0.001);
                } else {
                    group.rotation.x += 0.002;
                    group.rotation.y += 0.003;
                }
                
                // Entropy effect: Expand points over time
                if (entropy) {
                    geometry.attributes.position.array = geometry.attributes.position.array.map((val, index) => {
                        return val * (1 + 0.0005 * Math.sin(Date.now() * 0.0005));
                    });
                    geometry.attributes.position.needsUpdate = true;
                }
                
                renderer.render(scene, camera);
            }
            animate();
        }

        // Create four visualizations
        createScene("canvas1", false, false); // Base Holographic Projection
        createScene("canvas2", true, false);  // Observer Effects
        createScene("canvas3", true, true);   // Entropy Evolution with Observer Effects
        createScene("canvas4", true, true);   // Full Model: Entropy + Observer Effects
    </script>
</body>
</html>
